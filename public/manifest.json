{
  "manifest_version": 3,
  "name": "Take me there",
  "version": "1.0.0",
  "description": "Right-click any image to identify the place with Muse AI.",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "service-worker.js" },
  "permissions": ["alarms", "contextMenus", "sidePanel", "scripting", "activeTab", "storage"],
  "host_permissions": ["https://api.meta.ai/*"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Take me there",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  }
}
