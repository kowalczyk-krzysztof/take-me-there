{
  "manifest_version": 3,
  "name": "Take Me There",
  "version": "1.0.0",
  "description": "Right-click any image to identify the place with Muse AI and plan a trip from the side panel.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "service-worker.js" },
  "permissions": ["contextMenus", "sidePanel", "scripting", "activeTab", "storage"],
  "host_permissions": ["https://api.meta.ai/*"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "side_panel": { "default_path": "sidepanel.html" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "action": {
    "default_title": "Take Me There",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period" }
    }
  }
}
