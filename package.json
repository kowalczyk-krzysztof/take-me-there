{
  "name": "take-me-there",
  "version": "1.0.0",
  "description": "Right-click any image to identify the place.",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/components/**/*.tsx"
  ],
  "scripts": {
    "dev": "rspack build --config rspack.config.mjs --mode development --watch",
    "build": "rspack build --config rspack.config.mjs --mode production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "zip": "npm run build && node scripts/verify-bundle.mjs && cd dist && zip -qr ../take-me-there.zip .",
    "verify-injected": "node scripts/verify-injected.mjs",
    "smoke:chrome": "node scripts/smoke-chrome.mjs",
    "eval:recognition": "node scripts/recognition-eval.mjs"
  },
  "dependencies": {
    "idb-keyval": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.2.9",
    "@rspack/core": "2.2.9",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-types": "0.1.461",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
